FROM nrel/openstudio:3.9.0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    ENERGYPLUS_BIN=/usr/local/openstudio-3.9.0/EnergyPlus/energyplus \
    ENERGYPLUS_WEATHER_DIR=/var/oscli/gems/ruby/3.2.0/gems/openstudio-standards-0.7.0/data/weather
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt
COPY twin twin
COPY tools tools
COPY models models
CMD ["python3", "-m", "twin.runner"]
