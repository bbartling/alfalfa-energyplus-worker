# Local deployment settings. Copy to .env. These are development credentials,
# not the upstream image defaults. Do not reuse them anywhere but a local stack.
AWS_ACCESS_KEY_ID=alfalfa_local_key
AWS_SECRET_ACCESS_KEY=alfalfa_local_secret
MONGO_INITDB_ROOT_USERNAME=alfalfa
MONGO_INITDB_ROOT_PASSWORD=alfalfa_local_secret
MONGO_INITDB_DATABASE=alfalfa
MONGO_URL=mongodb://alfalfa:alfalfa_local_secret@mongo:27017/alfalfa?authSource=admin
REDIS_URL=redis://redis:6379/0
JOB_QUEUE="Alfalfa Job Queue"
NODE_ENV=production
S3_REGION=us-west-1
S3_BUCKET=alfalfa
S3_URL=http://minio:9000
# Clients on the Compose network (Linux and Docker Desktop) use the service name.
S3_URL_EXTERNAL=http://minio:9000
REGISTRY_BASE_URI=ghcr.io/natlabrockies/alfalfa
VERSION_TAG=pinned
TWIN_HTTP_PORT=18080
TWIN_BOOTSTRAP_KEY=local-demo-key
TWIN_DASHBOARD_OPEN=1
DATABASE_URL=postgresql+psycopg://twin:twin@db:5432/twin
POSTGRES_USER=twin
POSTGRES_PASSWORD=twin
POSTGRES_DB=twin
